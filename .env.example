# DeepSeek（必填；通过 Anthropic Messages 兼容协议调用）
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# 迁移兼容：旧部署仍可使用 ANTHROPIC_API_KEY / ANTHROPIC_MODEL / ANTHROPIC_BASE_URL。

# 应用
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Docker Compose 会在应用容器中覆盖 Redis/ChromaDB 的连接地址。
REDIS_PASSWORD=echomind123
REDIS_URL=redis://:echomind123@localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Skills
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# 监控与评测
# 主应用已经在 /metrics 暴露指标，因此默认不另开 Prometheus HTTP 端口。
PROMETHEUS_PORT=0
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=
EVAL_BASELINE_PATH=./data/eval/baseline.json
